# Secrets — never commit
.env
.env.*
*.env
*.pem
*.key
*secret*
*key*.json

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
site-packages/

# ngrok
ngrok.exe
ngrok
*.ngrok.log

# Logs — regenerated at runtime (factory_orchestrator.log alone is 18 MB)
*.log
factory_orchestrator.log

# Audio scratch (voice pipeline writes here at runtime; none present now)
*.wav
*.mp3
audio_tmp/
tmp_audio/

# Stale local backups — never commit
app_backup_*.py
*_backup*/
backups/
